# --- Go ---
/bin/
*.test
*.out
coverage.*
# NOTE: go.sum is intentionally NOT ignored

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- CloudGuard runtime output ---
artifacts/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
