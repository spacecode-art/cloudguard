# --- Secrets (never commit) ---
.env
.env.*
*.pem
*.key
credentials
*.tfvars
!*.tfvars.example

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
crash.log
